FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG SERVICE_PROJECT
WORKDIR /src
COPY building-blocks/ building-blocks/
COPY services/ services/
RUN test -n "$SERVICE_PROJECT" && dotnet publish "$SERVICE_PROJECT" -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG SERVICE_ASSEMBLY
ENV SERVICE_ASSEMBLY=$SERVICE_ASSEMBLY
# Npgsql loads GSSAPI during connection initialization even when the local DSN uses password auth.
# Ubuntu-based .NET runtime images omit the Kerberos client library, so install it explicitly.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet \"$SERVICE_ASSEMBLY\" \"$@\"", "fieldops-service"]
