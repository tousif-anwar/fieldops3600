%% Default policy in minutes. Development demo substitutes seconds explicitly.
flowchart TB
  Clock["Server UTC stage start and deadline<br/>Quartz sweep or late-submission catch-up"] --> Timeline
  subgraph Timeline["Elapsed stage time"]
    direction LR
    OnTime["0–19 min<br/>On Time"] --> Warning["20 min<br/>Warning<br/>Technician"]
    Warning --> Critical["25 min<br/>Critical warning<br/>Technician"]
    Critical --> Breach["30 min<br/>Breached<br/>Supervisor escalation"]
  end
  Timeline --> Commit["Threshold level + aggregate version + outbox<br/>One transaction, idempotent milestone generation"]
  subgraph Controls["Pause and recovery"]
    direction LR
    Restart["Restart recovers<br/>persisted state"]
    Pause["Approved pause excludes time<br/>Resume extends the deadline"]
    History["Earlier breaches<br/>remain evidence"]
  end
  Controls --> Clock
  classDef normal fill:#EAF2FF,stroke:#2862B4,color:#172B4D
  classDef warning fill:#FFF7E6,stroke:#B27A17,color:#172B4D
  classDef breach fill:#FFF1ED,stroke:#B85A38,color:#172B4D
  class OnTime,Clock,Commit,Restart,Pause,History normal
  class Warning,Critical warning
  class Breach breach
