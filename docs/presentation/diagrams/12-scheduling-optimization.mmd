%% Operational advice is one fixed appointment; synthetic batch evaluation is separate.
flowchart LR
  Request["Dispatcher<br/>Order, start, duration, strategy"] --> Scope["Scheduling Service<br/>Role / team / order state"]
  Scope --> Inputs["HTTP staff + time-off checks<br/>Owned confirmed bookings"]
  Inputs --> Hard["Hard constraints<br/>Skill, certification, availability<br/>Local hours, duration, overlap"]
  Hard --> Choice{"Explicit strategy"}
  Choice -->|"baseline"| Rank["Rank feasible technicians<br/>Lower booked workload first"]
  Choice -->|"optimized"| Solver["Private Python OR-Tools CP-SAT<br/>Fixed integer-minute window"]
  Solver --> Verify["Independent response validation<br/>Known technician / job / interval<br/>Feasible solver status"]
  Rank --> Advice["Recommendation and explanation<br/>Operational travel = unavailable"]
  Verify --> Advice
  Advice --> Human["Dispatcher accepts or overrides<br/>Reason required where applicable"]
  Human --> Recheck["Recheck current constraints"]
  Recheck --> Commit[("PostgreSQL booking transaction<br/>No-overlap and one-order constraints")]
  Dataset["Separate reproducible synthetic dataset<br/>Six technicians, 22 jobs"] -.-> Evaluation["Baseline / solver comparison<br/>Depot proxy, runtime, workload<br/>No real routing claim"]
