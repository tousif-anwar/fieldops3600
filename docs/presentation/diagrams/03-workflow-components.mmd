%% Component view inside Workflows, not additional services.
flowchart TB
  subgraph Entry["Command and timer inputs"]
    direction LR
    Endpoint["OperationsApi<br/>JWT policy and resource scope"]
    Clock["Quartz SlaSweep<br/>Persisted-state catch-up"]
  end
  Entry --> Rules["WorkflowEngine and Templates<br/>Pinned schema, version and legal transition"]
  Rules --> Commit["ServiceDb transaction<br/>State + idempotency receipt + outbox"]
  Audit["SlaAudit / EventFactory<br/>Causation and trace metadata"] --> Commit
  Commit --> Owned[("Workflow database<br/>workflows with StagesJson<br/>idempotency_receipts + outbox_messages")]
  Owned --> Publisher["OutboxDispatcher<br/>Row locks, stable EventId, retry"]
  Publisher -.-> Rabbit["MassTransit / RabbitMQ"]
  classDef code fill:#EAF2FF,stroke:#2862B4,color:#172B4D
  classDef data fill:#E8F5F1,stroke:#27836B,color:#172B4D
  class Endpoint,Clock,Rules,Commit,Audit,Publisher code
  class Owned data