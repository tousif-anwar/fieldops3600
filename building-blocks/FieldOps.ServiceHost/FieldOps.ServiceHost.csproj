<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><OutputType>Library</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FieldOps.Core/FieldOps.Core.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.5" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../services/work-orders/migrations/*.sql" LogicalName="work-orders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../services/technicians/migrations/*.sql" LogicalName="technicians.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../services/scheduling/migrations/*.sql" LogicalName="scheduling.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../services/workflows/migrations/*.sql" LogicalName="workflows.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../services/notifications/migrations/*.sql" LogicalName="notifications.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../services/reporting/migrations/*.sql" LogicalName="reporting.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
