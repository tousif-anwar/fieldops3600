{
  "expo": {
    "name": "FieldOps 360",
    "slug": "fieldops-technician",
    "scheme": "fieldops360",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fieldops360.technician",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fieldops360.technician"
    },
    "web": { "output": "single" },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": { "typedRoutes": true }
  }
}
